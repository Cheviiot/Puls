#include <windows.h>

1 ICON "@PULS_WINDOWS_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Puls\0"
            VALUE "FileVersion", "@PULS_VERSION_LABEL@\0"
            VALUE "InternalName", "puls\0"
            VALUE "OriginalFilename", "puls.exe\0"
            VALUE "ProductName", "Puls\0"
            VALUE "ProductVersion", "@PULS_VERSION_LABEL@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
