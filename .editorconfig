root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{*.cpp,*.hpp,*.h,*.qml,*.cmake,CMakeLists.txt}]
indent_style = space
indent_size = 4

[{*.yml,*.yaml,*.json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.ps1]
charset = utf-8-bom
